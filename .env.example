# Copy to .env (git-ignored) or run `make env` to generate one with random values.
# Placeholders only. Never commit real values.

# demo | production
APP_ENV=demo
# Required in production: at least 32 characters, not a placeholder.
SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-random-value
# Comma-separated origins allowed to call the API from a browser (needed for a separately hosted frontend).
CORS_ORIGINS=http://localhost:8080
# First administrator, created by `make create-admin` or at container start when both are set.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
