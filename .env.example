# Copy to .env (git-ignored) or run `make env` to generate one with random values.
# Placeholders only. Never commit real values.

# demo | production
APP_ENV=demo
# Required in production: at least 32 characters, not a placeholder.
SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-random-value
# Comma-separated origins allowed to call the API from a browser (needed for a separately hosted frontend).
CORS_ORIGINS=http://localhost:8080
# First administrator, created by `make create-admin` or at container start when both are set.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Host port for the web service (change it if 8080 is taken on your machine).
WEB_PORT=8080
# Bind address for the web port. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 to serve a LAN.
WEB_BIND=127.0.0.1

# --- HTTPS (Caddy, production on a VM) ---
# Your domain, or the VM's Azure DNS name such as myvm.westeurope.cloudapp.azure.com.
DOMAIN=
# Contact address for the certificate authority.
ACME_EMAIL=
# Optional: host ports for Caddy (defaults 80 and 443).
HTTP_PORT=80
HTTPS_PORT=443
# Optional: where `infra/backup.sh` writes backups and how many to keep.
BACKUP_DIR=./backups
BACKUP_KEEP=14

# --- Live sessions ---
# Seconds a running session waits for its trainee to reconnect before it is stored as abandoned.
SESSION_GRACE_S=120
# Live sessions held in memory at once (one API worker); more are refused.
MAX_LIVE_SESSIONS=32
