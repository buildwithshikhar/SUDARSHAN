# syntax=docker/dockerfile:1
# Build context is the repository root (brand.json is read at run time).
FROM python:3.12-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PIP_DISABLE_PIP_VERSION_CHECK=1
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY services/api/pyproject.toml services/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM python:3.12-slim
ARG PRODUCT_NAME=trainer
ARG GIT_SHA=dev
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.title="${PRODUCT_NAME} API" \
      org.opencontainers.image.description="API service" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_TIME}"
RUN useradd --system --uid 10001 --create-home app && mkdir /data && chown app /data
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY services/api/app ./app
COPY services/api/alembic ./alembic
COPY services/api/alembic.ini ./alembic.ini
COPY brand.json ./brand.json
COPY infra/api-entrypoint.sh ./entrypoint.sh
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    BRAND_FILE=/app/brand.json \
    DATABASE_URL=sqlite:////data/app.db \
    GIT_SHA=${GIT_SHA} \
    BUILD_TIME=${BUILD_TIME}
USER app
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/healthz', timeout=2)"
ENTRYPOINT ["/app/entrypoint.sh"]
