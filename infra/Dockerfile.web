# syntax=docker/dockerfile:1
# Build context is the repository root (the client reads brand.json at build time).
FROM node:25-alpine AS build
WORKDIR /repo/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web ./
COPY brand.json /repo/brand.json
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
ARG PRODUCT_NAME=trainer
ARG GIT_SHA=dev
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.title="${PRODUCT_NAME} web" \
      org.opencontainers.image.description="Web client and reverse proxy" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_TIME}"
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
