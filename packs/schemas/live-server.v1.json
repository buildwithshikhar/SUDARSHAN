    "Ack": {
      "additionalProperties": false,
      "description": "The server received action `seq` (ok) or refused it before it reached the simulation.\nThe simulation's own decision (ROE verdict, rejection) arrives as events.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AckError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "t": {
          "const": "ack",
          "title": "T",
          "type": "string"
        },
        "tick": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tick"
        }
      },
      "required": [
        "t",
        "seq",
        "ok"
      ],
      "title": "Ack",
      "type": "object"
    },
    "AckError": {
      "additionalProperties": false,
