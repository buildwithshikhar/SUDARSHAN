{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "description": "All present fields must hold for a rule to apply; an absent field matches anything.",
      "properties": {
        "classification_in": {
          "anyOf": [
            {
              "items": {
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification In"
        },
        "identity_in": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "hostile",
                  "suspect",
                  "unknown",
                  "neutral",
                  "friend"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity In"
        },
        "min_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Confidence"
        },
        "zone_role_in": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "inner",
                  "outer",
                  "restricted"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Role In"
        }
      },
      "title": "Condition",
      "type": "object"
    },
    "EffectorClass": {
      "additionalProperties": false,
      "description": "A generic, fictional response class. No real system names or performance figures.",
      "properties": {
        "description": {
          "$ref": "#/$defs/Text"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "max_range": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "max_range"
      ],
      "title": "EffectorClass",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A numeric parameter with its unit and provenance.",
      "properties": {
        "source_id": {
          "pattern": "^[DGWXF][0-9]{2}$",
          "title": "Source Id",
          "type": "string"
        },
        "unit": {
          "maxLength": 24,
          "pattern": "^[A-Za-z%°µ][A-Za-z0-9%°µ/^.\\-]*$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "verified": {
          "description": "True only when the value was checked against the source.",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "unit",
        "source_id",
        "verified"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "ReportGrading": {
      "additionalProperties": false,
      "description": "Tolerances and marks for the structured contact report (fictional, editable).",
      "properties": {
        "count_off_by_one_score": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Count Off By One Score",
          "type": "number"
        },
        "count_radius_m": {
          "default": 250.0,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Count Radius M",
          "type": "number"
        },
        "heading_tolerance_deg": {
          "default": 20.0,
          "exclusiveMinimum": 0,
          "maximum": 90,
          "title": "Heading Tolerance Deg",
          "type": "number"
        },
        "heading_zero_factor": {
          "default": 3.0,
          "exclusiveMinimum": 1,
          "maximum": 20,
          "title": "Heading Zero Factor",
          "type": "number"
        },
        "position_tolerance_m": {
          "default": 150.0,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Position Tolerance M",
          "type": "number"
        },
        "position_zero_factor": {
          "default": 3.0,
          "exclusiveMinimum": 1,
          "maximum": 20,
          "title": "Position Zero Factor",
          "type": "number"
        },
        "timeliness_weight": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Timeliness Weight",
          "type": "number"
        },
        "weights": {
          "$ref": "#/$defs/ReportWeights",
          "default": {
            "calibration": 0.15,
            "count": 0.15,
            "heading": 0.15,
            "what": 0.3,
            "where": 0.25
          }
        }
      },
      "title": "ReportGrading",
      "type": "object"
    },
    "ReportWeights": {
      "additionalProperties": false,
      "description": "How the five report fields add up to the report-quality score (sum to 1).",
      "properties": {
        "calibration": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Calibration",
          "type": "number"
        },
        "count": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Count",
          "type": "number"
        },
        "heading": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Heading",
          "type": "number"
        },
        "what": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "What",
          "type": "number"
        },
        "where": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Where",
          "type": "number"
        }
      },
      "title": "ReportWeights",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "operator",
            "commander"
          ],
          "title": "Authority",
          "type": "string"
        },
        "effector_classes": {
          "default": [],
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Effector Classes",
          "type": "array"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "permits": {
          "items": {
            "enum": [
              "designate",
              "classify",
              "assess",
              "engage",
              "hold",
              "report"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Permits",
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "when": {
          "$ref": "#/$defs/Condition"
        }
      },
      "required": [
        "id",
        "title",
        "when",
        "permits",
        "authority"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Scoring": {
      "additionalProperties": false,
      "description": "How the decision tree turns what the operator did into marks. All fictional and editable.",
      "properties": {
        "assess_credit": {
          "additionalProperties": {
            "additionalProperties": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "propertyNames": {
              "enum": [
                "hostile",
                "suspect",
                "unknown",
                "neutral",
                "friend"
              ]
            },
            "type": "object"
          },
          "default": {
            "civil-permitted": {
              "friend": 0.5,
              "hostile": 0.0,
              "neutral": 1.0,
              "suspect": 0.0,
              "unknown": 0.25
            },
            "clutter": {
              "friend": 0.25,
              "hostile": 0.0,
              "neutral": 1.0,
              "suspect": 0.0,
              "unknown": 0.25
            },
            "hostile": {
              "friend": 0.0,
              "hostile": 1.0,
              "neutral": 0.0,
              "suspect": 0.5,
              "unknown": 0.1
            }
          },
          "propertyNames": {
            "enum": [
              "hostile",
              "civil-permitted",
              "clutter"
            ]
          },
          "title": "Assess Credit",
          "type": "object"
        },
        "blocked_attempt_penalty": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Blocked Attempt Penalty",
          "type": "number"
        },
        "classify_correct_share": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Classify Correct Share",
          "type": "number"
        },
        "effector_higher_factor": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Effector Higher Factor",
          "type": "number"
        },
        "false_engagement_cap": {
          "default": 0.45,
          "maximum": 1,
          "minimum": 0,
          "title": "False Engagement Cap",
          "type": "number"
        },
        "false_engagement_penalty": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "False Engagement Penalty",
          "type": "number"
        },
        "report": {
          "$ref": "#/$defs/ReportGrading",
          "default": {
            "count_off_by_one_score": 0.5,
            "count_radius_m": 250.0,
            "heading_tolerance_deg": 20.0,
            "heading_zero_factor": 3.0,
            "position_tolerance_m": 150.0,
            "position_zero_factor": 3.0,
            "timeliness_weight": 0.2,
            "weights": {
              "calibration": 0.15,
              "count": 0.15,
              "heading": 0.15,
              "what": 0.3,
              "where": 0.25
            }
          }
        },
        "respond_credit": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "default": {
            "engage": 1.0,
            "hold": 0.25,
            "none": 0.0,
            "report": 0.6
          },
          "propertyNames": {
            "enum": [
              "engage",
              "report",
              "hold",
              "none"
            ]
          },
          "title": "Respond Credit",
          "type": "object"
        },
        "respond_timing_share": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Respond Timing Share",
          "type": "number"
        },
        "timing_bands": {
          "default": [
            {
              "max_factor": 1.0,
              "score": 1.0
            },
            {
              "max_factor": 2.0,
              "score": 0.75
            },
            {
              "max_factor": 3.0,
              "score": 0.5
            },
            {
              "max_factor": 5.0,
              "score": 0.25
            }
          ],
          "items": {
            "$ref": "#/$defs/TimingBand"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Timing Bands",
          "type": "array"
        },
        "track_error_cap": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Track Error Cap",
          "type": "number"
        },
        "track_error_penalty": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Track Error Penalty",
          "type": "number"
        }
      },
      "title": "Scoring",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "description": "User-facing text in both interface languages.",
      "properties": {
        "en": {
          "maxLength": 400,
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "hi": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Hi",
          "type": "string"
        }
      },
      "required": [
        "en",
        "hi"
      ],
      "title": "Text",
      "type": "object"
    },
    "Thresholds": {
      "additionalProperties": false,
      "description": "Fictional, editable timing standards in seconds (no public doctrinal source; Q-12).\n\nEach is measured from the first moment a sensor reported the contact.",
      "properties": {
        "classify_within_s": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Classify Within S",
          "type": "number"
        },
        "detect_within_s": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Detect Within S",
          "type": "number"
        },
        "report_within_s": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Report Within S",
          "type": "number"
        },
        "respond_within_s": {
          "default": 45.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Respond Within S",
          "type": "number"
        }
      },
      "required": [
        "detect_within_s",
        "classify_within_s",
        "report_within_s"
      ],
      "title": "Thresholds",
      "type": "object"
    },
    "TimingBand": {
      "additionalProperties": false,
      "description": "Credit for a response that took up to `max_factor` times the standard.",
      "properties": {
        "max_factor": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Max Factor",
          "type": "number"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "max_factor",
        "score"
      ],
      "title": "TimingBand",
      "type": "object"
    },
    "Weights": {
      "additionalProperties": false,
      "properties": {
        "assess": {
          "maximum": 1,
          "minimum": 0,
          "title": "Assess",
          "type": "number"
        },
        "classify": {
          "maximum": 1,
          "minimum": 0,
          "title": "Classify",
          "type": "number"
        },
        "detect": {
          "maximum": 1,
          "minimum": 0,
          "title": "Detect",
          "type": "number"
        },
        "report": {
          "maximum": 1,
          "minimum": 0,
          "title": "Report",
          "type": "number"
        },
        "respond": {
          "maximum": 1,
          "minimum": 0,
          "title": "Respond",
          "type": "number"
        }
      },
      "required": [
        "detect",
        "classify",
        "assess",
        "respond",
        "report"
      ],
      "title": "Weights",
      "type": "object"
    }
  },
  "$id": "rulepack.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "rulepack.v1",
      "title": "Contract",
      "type": "string"
    },
    "default_action": {
      "const": "hold",
      "title": "Default Action",
      "type": "string"
    },
    "effector_classes": {
      "items": {
        "$ref": "#/$defs/EffectorClass"
      },
      "maxItems": 16,
      "title": "Effector Classes",
      "type": "array"
    },
    "fictional": {
      "const": true,
      "title": "Fictional",
      "type": "boolean"
    },
    "id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "scoring": {
      "$ref": "#/$defs/Scoring",
      "default": {
        "assess_credit": {
          "civil-permitted": {
            "friend": 0.5,
            "hostile": 0.0,
            "neutral": 1.0,
            "suspect": 0.0,
            "unknown": 0.25
          },
          "clutter": {
            "friend": 0.25,
            "hostile": 0.0,
            "neutral": 1.0,
            "suspect": 0.0,
            "unknown": 0.25
          },
          "hostile": {
            "friend": 0.0,
            "hostile": 1.0,
            "neutral": 0.0,
            "suspect": 0.5,
            "unknown": 0.1
          }
        },
        "blocked_attempt_penalty": 0.15,
        "classify_correct_share": 0.7,
        "effector_higher_factor": 0.7,
        "false_engagement_cap": 0.45,
        "false_engagement_penalty": 0.15,
        "report": {
          "count_off_by_one_score": 0.5,
          "count_radius_m": 250.0,
          "heading_tolerance_deg": 20.0,
          "heading_zero_factor": 3.0,
          "position_tolerance_m": 150.0,
          "position_zero_factor": 3.0,
          "timeliness_weight": 0.2,
          "weights": {
            "calibration": 0.15,
            "count": 0.15,
            "heading": 0.15,
            "what": 0.3,
            "where": 0.25
          }
        },
        "respond_credit": {
          "engage": 1.0,
          "hold": 0.25,
          "none": 0.0,
          "report": 0.6
        },
        "respond_timing_share": 0.3,
        "timing_bands": [
          {
            "max_factor": 1.0,
            "score": 1.0
          },
          {
            "max_factor": 2.0,
            "score": 0.75
          },
          {
            "max_factor": 3.0,
            "score": 0.5
          },
          {
            "max_factor": 5.0,
            "score": 0.25
          }
        ],
        "track_error_cap": 0.3,
        "track_error_penalty": 0.15
      }
    },
    "thresholds": {
      "$ref": "#/$defs/Thresholds"
    },
    "title": {
      "$ref": "#/$defs/Text"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){2}$",
      "title": "Version",
      "type": "string"
    },
    "weights": {
      "$ref": "#/$defs/Weights"
    }
  },
  "required": [
    "contract",
    "id",
    "version",
    "title",
    "fictional",
    "default_action",
    "effector_classes",
    "rules",
    "weights",
    "thresholds"
  ],
  "title": "RulePack",
  "type": "object"
}
