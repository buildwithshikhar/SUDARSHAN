{
  "$defs": {
    "DefendedAsset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "position": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "required": [
        "id",
        "label",
        "position"
      ],
      "title": "DefendedAsset",
      "type": "object"
    },
    "Drift": {
      "additionalProperties": false,
      "description": "Clutter motion: a free balloon carried by the wind (mean wind plus gust), climbing at\n`climb_mps` until the top of its altitude band; the route is ignored.",
      "properties": {
        "climb_mps": {
          "maximum": 3,
          "minimum": 0,
          "title": "Climb Mps",
          "type": "number"
        },
        "kind": {
          "const": "drift",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "climb_mps"
      ],
      "title": "Drift",
      "type": "object"
    },
    "FiledFlight": {
      "additionalProperties": false,
      "description": "A civil flight plan the trainee is told about: an area and a time window, nothing more.\n\nIt does not name the contact that flies it; matching a track to a plan is the trainee's job.",
      "properties": {
        "center": {
          "$ref": "#/$defs/Vec3"
        },
        "from_s": {
          "minimum": 0,
          "title": "From S",
          "type": "number"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "radius_m": {
          "exclusiveMinimum": 0,
          "maximum": 50000,
          "title": "Radius M",
          "type": "number"
        },
        "to_s": {
          "exclusiveMinimum": 0,
          "title": "To S",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "from_s",
        "to_s",
        "center",
        "radius_m"
      ],
      "title": "FiledFlight",
      "type": "object"
    },
    "FlatTerrain": {
      "additionalProperties": false,
      "properties": {
        "elevation_m": {
          "default": 0.0,
          "title": "Elevation M",
          "type": "number"
        },
        "kind": {
          "const": "flat",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FlatTerrain",
      "type": "object"
    },
    "GeneratedFrom": {
      "additionalProperties": false,
      "description": "Where a generated scenario came from: enough to make it again (docs/SCENARIO_ENGINE.md).",
      "properties": {
        "code": {
          "maxLength": 96,
          "minLength": 8,
          "pattern": "^[A-Z0-9-]+$",
          "title": "Code",
          "type": "string"
        },
        "generator_version": {
          "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){2}$",
          "title": "Generator Version",
          "type": "string"
        }
      },
      "required": [
        "generator_version",
        "code"
      ],
      "title": "GeneratedFrom",
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "description": "Members of a group are ordinary threats (own class, limits, spawn and start); the group\ndecides where they steer, and each member stays inside its own class envelope. Behaviour is\nkinematics only: a member goes where the group's own route and its group-mates take it.\n\nEvery numeric value is project-authored (register F01, verified: false); the model basis is\nReynolds boids, Vicsek noise, consensus with link loss and leader-follower, cited as the model\nand never as validation (docs/02-research.md section 3).",
      "properties": {
        "discipline": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Discipline",
          "type": "number"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "default": "transit",
          "enum": [
            "transit",
            "loiter",
            "probe",
            "saturation"
          ],
          "title": "Intent",
          "type": "string"
        },
        "kind": {
          "default": "swarm",
          "enum": [
            "swarm",
            "flock"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lane_spacing_m": {
          "default": 30.0,
          "maximum": 200,
          "minimum": 3,
          "title": "Lane Spacing M",
          "type": "number"
        },
        "leader": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leader"
        },
        "leader_loss": {
          "default": "elect",
          "enum": [
            "elect",
            "disperse",
            "loiter"
          ],
          "title": "Leader Loss",
          "type": "string"
        },
        "leader_loss_hold_s": {
          "default": 4.0,
          "maximum": 30,
          "minimum": 0,
          "title": "Leader Loss Hold S",
          "type": "number"
        },
        "link_epoch_s": {
          "default": 1.0,
          "maximum": 60,
          "minimum": 0.5,
          "title": "Link Epoch S",
          "type": "number"
        },
        "link_loss": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Link Loss",
          "type": "number"
        },
        "link_range_m": {
          "default": 150.0,
          "maximum": 5000,
          "minimum": 10,
          "title": "Link Range M",
          "type": "number"
        },
        "loiter_radius_m": {
          "default": 120.0,
          "maximum": 5000,
          "minimum": 20,
          "title": "Loiter Radius M",
          "type": "number"
        },
        "members": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Members",
          "type": "array"
        },
        "neighbour_radius_m": {
          "default": 80.0,
          "maximum": 1000,
          "minimum": 5,
          "title": "Neighbour Radius M",
          "type": "number"
        },
        "on_route_end": {
          "default": "loiter",
          "enum": [
            "loiter",
            "loop",
            "despawn"
          ],
          "title": "On Route End",
          "type": "string"
        },
        "probe_cycles": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Probe Cycles",
          "type": "integer"
        },
        "probe_standoff_m": {
          "default": 200.0,
          "maximum": 5000,
          "minimum": 10,
          "title": "Probe Standoff M",
          "type": "number"
        },
        "route": {
          "items": {
            "$ref": "#/$defs/Waypoint"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Route",
          "type": "array"
        },
        "spacing_m": {
          "default": 20.0,
          "maximum": 200,
          "minimum": 3,
          "title": "Spacing M",
          "type": "number"
        },
        "topology": {
          "default": "leaderless",
          "enum": [
            "leader-follower",
            "leaderless"
          ],
          "title": "Topology",
          "type": "string"
        },
        "weights": {
          "$ref": "#/$defs/GroupWeights"
        }
      },
      "required": [
        "id",
        "members",
        "route"
      ],
      "title": "Group",
      "type": "object"
    },
    "GroupWeights": {
      "additionalProperties": false,
      "description": "Weights of the four flocking terms (Reynolds boids). Project-authored (register F01,\nverified: false).",
      "properties": {
        "alignment": {
          "default": 1.5,
          "maximum": 5,
          "minimum": 0,
          "title": "Alignment",
          "type": "number"
        },
        "cohesion": {
          "default": 0.6,
          "maximum": 5,
          "minimum": 0,
          "title": "Cohesion",
          "type": "number"
        },
        "goal": {
          "default": 1.0,
          "maximum": 5,
          "minimum": 0,
          "title": "Goal",
          "type": "number"
        },
        "separation": {
          "default": 1.0,
          "maximum": 5,
          "minimum": 0,
          "title": "Separation",
          "type": "number"
        }
      },
      "title": "GroupWeights",
      "type": "object"
    },
    "KinematicLimits": {
      "additionalProperties": false,
      "description": "Envelope of a threat class. Airspeed, not ground speed, is limited.",
      "properties": {
        "max_accel_mps2": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Max Accel Mps2",
          "type": "number"
        },
        "max_altitude_m": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Max Altitude M",
          "type": "number"
        },
        "max_climb_mps": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Max Climb Mps",
          "type": "number"
        },
        "max_descent_mps": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Max Descent Mps",
          "type": "number"
        },
        "max_speed_mps": {
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Max Speed Mps",
          "type": "number"
        },
        "max_turn_rate_dps": {
          "exclusiveMinimum": 0,
          "maximum": 360,
          "title": "Max Turn Rate Dps",
          "type": "number"
        },
        "min_altitude_m": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Min Altitude M",
          "type": "number"
        }
      },
      "required": [
        "max_speed_mps",
        "max_accel_mps2",
        "max_climb_mps",
        "max_descent_mps",
        "max_turn_rate_dps",
        "min_altitude_m",
        "max_altitude_m"
      ],
      "title": "KinematicLimits",
      "type": "object"
    },
    "PackRef": {
      "additionalProperties": false,
      "description": "Reference to another versioned pack by ID and exact version.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){2}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "PackRef",
      "type": "object"
    },
    "PackTerrain": {
      "additionalProperties": false,
      "description": "A baked terrain pack (`packs/terrain/<id>/`, docs/TERRAIN_PACKS.md). Positions in the\nscenario are metres above the pack datum, in the pack's local frame.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "pack",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){2}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "title": "PackTerrain",
      "type": "object"
    },
    "ScenarioMeta": {
      "additionalProperties": false,
      "description": "What the scenario library shows and filters on. Optional, and never read by the sim.",
      "properties": {
        "curriculum_order": {
          "anyOf": [
            {
              "maximum": 999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curriculum Order"
        },
        "difficulty": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "generated": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "default": "scripted",
          "enum": [
            "scripted",
            "generated",
            "authored",
            "example"
          ],
          "title": "Origin",
          "type": "string"
        },
        "playable": {
          "default": true,
          "title": "Playable",
          "type": "boolean"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Tags",
          "type": "array"
        }
      },
      "title": "ScenarioMeta",
      "type": "object"
    },
    "SensorDegradation": {
      "additionalProperties": false,
      "description": "A time-limited condition that makes one of the scenario's sensors worse (docs/SIM_CORE.md,\n\"Sensor framework\"): the same data an instructor inject carries (wave 10b).",
      "properties": {
        "from_s": {
          "minimum": 0,
          "title": "From S",
          "type": "number"
        },
        "kind": {
          "enum": [
            "outage",
            "sector-outage",
            "clutter",
            "haze",
            "glare",
            "interference",
            "wind-noise"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sector_from_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector From Deg"
        },
        "sector_to_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector To Deg"
        },
        "sensor": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Sensor",
          "type": "string"
        },
        "severity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        },
        "to_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To S"
        }
      },
      "required": [
        "sensor",
        "kind",
        "from_s"
      ],
      "title": "SensorDegradation",
      "type": "object"
    },
    "SensorPlacement": {
      "additionalProperties": false,
      "properties": {
        "boresight_deg": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Boresight Deg",
          "type": "number"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "profile": {
          "$ref": "#/$defs/PackRef"
        }
      },
      "required": [
        "id",
        "profile",
        "position",
        "boresight_deg"
      ],
      "title": "SensorPlacement",
      "type": "object"
    },
    "Tether": {
      "additionalProperties": false,
      "description": "Clutter motion: a kite held on a line from a fixed anchor. It rides downwind of the anchor\nat about 50 degrees elevation, swaying across the wind; the route is ignored.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Vec3"
        },
        "kind": {
          "const": "tether",
          "title": "Kind",
          "type": "string"
        },
        "length_m": {
          "maximum": 300,
          "minimum": 5,
          "title": "Length M",
          "type": "number"
        },
        "sway_m": {
          "maximum": 100,
          "minimum": 0,
          "title": "Sway M",
          "type": "number"
        },
        "sway_period_s": {
          "maximum": 60,
          "minimum": 2,
          "title": "Sway Period S",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "anchor",
        "length_m",
        "sway_m",
        "sway_period_s"
      ],
      "title": "Tether",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "description": "User-facing text in both interface languages.",
      "properties": {
        "en": {
          "maxLength": 400,
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "hi": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Hi",
          "type": "string"
        }
      },
      "required": [
        "en",
        "hi"
      ],
      "title": "Text",
      "type": "object"
    },
    "Threat": {
      "additionalProperties": false,
      "properties": {
        "class_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Class Id",
          "type": "string"
        },
        "disposition": {
          "default": "hostile",
          "enum": [
            "hostile",
            "civil-permitted",
            "clutter"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "limits": {
          "$ref": "#/$defs/KinematicLimits"
        },
        "motion": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "drift": "#/$defs/Drift",
                  "tether": "#/$defs/Tether"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Tether"
                },
                {
                  "$ref": "#/$defs/Drift"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motion"
        },
        "on_route_end": {
          "enum": [
            "loiter",
            "loop",
            "despawn"
          ],
          "title": "On Route End",
          "type": "string"
        },
        "route": {
          "items": {
            "$ref": "#/$defs/Waypoint"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Route",
          "type": "array"
        },
        "spawn_s": {
          "minimum": 0,
          "title": "Spawn S",
          "type": "number"
        },
        "start": {
          "$ref": "#/$defs/Vec3"
        },
        "start_heading_deg": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Start Heading Deg",
          "type": "number"
        },
        "start_speed_mps": {
          "maximum": 120,
          "minimum": 0,
          "title": "Start Speed Mps",
          "type": "number"
        }
      },
      "required": [
        "id",
        "class_id",
        "label",
        "spawn_s",
        "start",
        "start_heading_deg",
        "start_speed_mps",
        "limits",
        "route",
        "on_route_end"
      ],
      "title": "Threat",
      "type": "object"
    },
    "Vec3": {
      "additionalProperties": false,
      "description": "Local east-north-up position in metres; z is height above the flat ground plane.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vec3",
      "type": "object"
    },
    "Waypoint": {
      "additionalProperties": false,
      "properties": {
        "hold_s": {
          "default": 0.0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Hold S",
          "type": "number"
        },
        "position": {
          "$ref": "#/$defs/Vec3"
        },
        "speed_mps": {
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Speed Mps",
          "type": "number"
        }
      },
      "required": [
        "position",
        "speed_mps"
      ],
      "title": "Waypoint",
      "type": "object"
    },
    "Weather": {
      "additionalProperties": false,
      "description": "Modelled weather at session start. Wind blows from `wind_from_deg` (0 = north).",
      "properties": {
        "cloud_cover_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Cloud Cover Pct",
          "type": "number"
        },
        "condition": {
          "enum": [
            "clear",
            "haze",
            "rain",
            "fog",
            "dust"
          ],
          "title": "Condition",
          "type": "string"
        },
        "gust_sigma_mps": {
          "maximum": 10,
          "minimum": 0,
          "title": "Gust Sigma Mps",
          "type": "number"
        },
        "temperature_c": {
          "maximum": 55,
          "minimum": -40,
          "title": "Temperature C",
          "type": "number"
        },
        "visibility_m": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Visibility M",
          "type": "number"
        },
        "wind_from_deg": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Wind From Deg",
          "type": "number"
        },
        "wind_speed_mps": {
          "maximum": 40,
          "minimum": 0,
          "title": "Wind Speed Mps",
          "type": "number"
        }
      },
      "required": [
        "condition",
        "visibility_m",
        "wind_speed_mps",
        "wind_from_deg",
        "gust_sigma_mps",
        "temperature_c",
        "cloud_cover_pct"
      ],
      "title": "Weather",
      "type": "object"
    },
    "World": {
      "additionalProperties": false,
      "properties": {
        "half_extent_m": {
