        "half_extent_m",
        "start_time_of_day_h",
        "weather"
      ],
      "title": "World",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "description": "Circular zone on the ground plane around a centre point.",
      "properties": {
        "center": {
          "$ref": "#/$defs/Vec3"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
