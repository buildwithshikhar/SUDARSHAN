{
  "$defs": {
    "ConfusionTable": {
      "additionalProperties": false,
      "description": "How a sensor labels each true class: one row per true class, one column per label.\n\nRows are probabilities and sum to 1 (row-normalised). The columns are the labels the sensor\ncan report, `unknown` included; the true classes need not be a subset of them.",
      "properties": {
        "labels": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 2,
          "title": "Labels",
          "type": "array"
        },
        "rows": {
          "maxProperties": 64,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
              "items": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "type": "array"
            }
          },
          "propertyNames": {
            "maxLength": 64
          },
          "title": "Rows",
          "type": "object"
        },
        "source_id": {
          "pattern": "^[DGWXF][0-9]{2}$",
          "title": "Source Id",
          "type": "string"
        },
        "verified": {
          "description": "True only when the matrix was checked against the source.",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "labels",
        "rows",
        "source_id",
        "verified"
      ],
      "title": "ConfusionTable",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A numeric parameter with its unit and provenance.",
      "properties": {
        "source_id": {
          "pattern": "^[DGWXF][0-9]{2}$",
          "title": "Source Id",
          "type": "string"
        },
        "unit": {
          "maxLength": 24,
          "pattern": "^[A-Za-z%°µ][A-Za-z0-9%°µ/^.\\-]*$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "verified": {
          "description": "True only when the value was checked against the source.",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "unit",
        "source_id",
        "verified"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "description": "User-facing text in both interface languages.",
      "properties": {
        "en": {
          "maxLength": 400,
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "hi": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Hi",
          "type": "string"
        }
      },
      "required": [
        "en",
        "hi"
      ],
      "title": "Text",
      "type": "object"
    }
  },
  "$id": "sensor-profile.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confusion": {
      "default": {},
      "maxProperties": 8,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/ConfusionTable"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Confusion",
      "type": "object"
    },
    "contract": {
      "const": "sensor-profile.v1",
      "title": "Contract",
      "type": "string"
    },
    "fictional": {
      "const": true,
      "title": "Fictional",
      "type": "boolean"
    },
    "id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "modality": {
      "enum": [
        "radar",
        "eo",
        "ir",
        "rf",
        "acoustic"
      ],
      "title": "Modality",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameters": {
      "additionalProperties": false,
      "maxProperties": 128,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Parameters",
      "type": "object"
    },
    "title": {
      "$ref": "#/$defs/Text"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){2}$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "id",
    "version",
    "title",
    "modality",
    "fictional",
    "parameters"
  ],
  "title": "SensorProfile",
  "type": "object"
}
